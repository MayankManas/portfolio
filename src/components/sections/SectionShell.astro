---
/**
 * The frame every section shares: the anchor id the scroll-spy targets, the
 * accent hairline, and the h2. Sections own their content and nothing else, so
 * spacing and heading level stay consistent without each renderer restating
 * them.
 *
 * `title: null` in site.yaml renders the section with no heading at all.
 */
interface Props {
  id: string;
  title: string | null;
}

const { id, title } = Astro.props;
---

<section id={id} class="section" aria-labelledby={title ? `${id}-heading` : undefined}>
  <div class="u-page">
    {
      title && (
        <div class="section__head">
          <h2 id={`${id}-heading`} class="section__title">
            {title}
          </h2>
        </div>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-2xl);
  }

  /* An accent hairline instead of a heavy header block - see docs/02-design.md. */
  .section__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .section__head::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--accent), transparent);
    opacity: 0.55;
  }

  .section__title {
    font-size: var(--text-section);
    margin: 0;
  }
</style>
