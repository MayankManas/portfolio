---
import { getResume } from '../lib/content';
import { isTodo, real } from '../lib/placeholder';

/**
 * Above the fold: the name, what he is, where he is, and exactly four links -
 * GitHub, LinkedIn, resume PDF, email. Nothing competes with those.
 *
 * Driven entirely by resume.yaml's `basics`, so it is still a content edit.
 * The headline is deliberately NOT here: it is the `about` prose section
 * directly below, which keeps the claim under site.yaml's control rather than
 * duplicating it in two places.
 *
 * TODO values in the seeded content render as a visible placeholder rather
 * than silently vanishing, so they cannot be forgotten before launch.
 */
const { basics } = getResume();

const locationParts = [basics.location.city, basics.location.region, basics.location.country]
  .filter((part): part is string => !isTodo(part));
const location = locationParts.join(', ');
const phone = real(basics.phone);

const profileLinks = basics.profiles
  .filter((profile) => !isTodo(profile.url))
  .map((profile) => ({ label: profile.network, href: profile.url }));

const missingProfiles = basics.profiles
  .filter((profile) => isTodo(profile.url))
  .map((profile) => profile.network);

const links = [
  ...profileLinks,
  { label: 'Résumé (PDF)', href: '/resume.pdf' },
  // The link text is the address itself, not the word "Email": a scraper that
  // strips tags keeps only text, and an address that lives solely in an href
  // does not survive that.
  { label: basics.email, href: `mailto:${basics.email}` },
];
---

<header class="hero">
  <div class="u-page">
    <h1 class="hero__name">{basics.name}</h1>
    <p class="hero__label">{basics.label}</p>

    <p class="hero__meta">
      {location && <span>{location}</span>}
      {phone && <span>{phone}</span>}
      {basics.availability && <span class="hero__availability">{basics.availability}</span>}
    </p>

    <nav class="hero__links" aria-label="Profiles and contact">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    {
      missingProfiles.length > 0 && (
        <p class="hero__todo">
          Launch checklist: {missingProfiles.join(', ')} URL still set to TODO in
          content/resume.yaml
        </p>
      )
    }
  </div>
</header>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-md);
  }

  .hero__name {
    font-size: var(--text-display);
    margin: 0;
  }

  .hero__label {
    margin: var(--space-sm) 0 0;
    font-size: var(--text-lead);
    color: var(--ink-muted);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: var(--space-md) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--ink-muted);
  }

  .hero__availability {
    color: var(--accent);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.02em;
  }

  .hero__links a {
    text-decoration-color: var(--rule-strong);
  }

  .hero__links a:hover {
    text-decoration-color: var(--accent);
  }

  /* Visible on purpose - a placeholder that hides itself is a placeholder that
     ships. Disappears as soon as the value is filled in. */
  .hero__todo {
    margin: var(--space-lg) 0 0;
    padding: var(--space-xs) var(--space-sm);
    border-left: 2px solid var(--accent);
    background: var(--bg-raised);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--ink-muted);
  }
</style>
