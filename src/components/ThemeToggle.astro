---
/**
 * Light/dark toggle. Enhancement only: with JS disabled the button is hidden
 * and the page still renders correctly from prefers-color-scheme.
 * The SVGs are pure shapes — no <text>, which would pollute extracted content.
 */
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  hidden
  aria-pressed="false"
>
  <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
    <circle cx="12" cy="12" r="4.4" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
    <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <line x1="12" y1="1.8" x2="12" y2="4.2"></line>
      <line x1="12" y1="19.8" x2="12" y2="22.2"></line>
      <line x1="1.8" y1="12" x2="4.2" y2="12"></line>
      <line x1="19.8" y1="12" x2="22.2" y2="12"></line>
      <line x1="4.9" y1="4.9" x2="6.6" y2="6.6"></line>
      <line x1="17.4" y1="17.4" x2="19.1" y2="19.1"></line>
      <line x1="19.1" y1="4.9" x2="17.4" y2="6.6"></line>
      <line x1="6.6" y1="17.4" x2="4.9" y2="19.1"></line>
    </g>
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
    <path
      d="M20.5 14.4A8.6 8.6 0 0 1 9.6 3.5a8.6 8.6 0 1 0 10.9 10.9Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"></path>
  </svg>
  <span class="u-sr-only" id="theme-toggle-label">Switch to dark theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  /* Show the icon for the theme you would switch TO. */
  .icon-moon {
    display: none;
  }

  :global(:root[data-resolved-theme='dark']) .icon-sun {
    display: none;
  }

  :global(:root[data-resolved-theme='dark']) .icon-moon {
    display: block;
  }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    const label = document.getElementById('theme-toggle-label');
    if (!btn || !label) return;

    // Only reveal the control once we know scripting works.
    btn.hidden = false;

    const root = document.documentElement;

    const systemDark = () =>
      window.matchMedia('(prefers-color-scheme: dark)').matches;

    const resolved = () => {
      const forced = root.getAttribute('data-theme');
      if (forced === 'dark' || forced === 'light') return forced;
      return systemDark() ? 'dark' : 'light';
    };

    const sync = () => {
      const current = resolved();
      root.setAttribute('data-resolved-theme', current);
      btn.setAttribute('aria-pressed', String(current === 'dark'));
      label.textContent =
        current === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
    };

    btn.addEventListener('click', () => {
      const next = resolved() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* private mode / blocked storage — the choice just won't persist */
      }
      sync();
    });

    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', sync);

    sync();
  })();
</script>
